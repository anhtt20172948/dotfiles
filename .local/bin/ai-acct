#!/bin/sh
# Tokens and the selector stay outside dotfiles; Claude history stays shared.
set +x
set -eu
accounts=$HOME/.config/claude-accounts
fm_home=${FM_HOME:-$HOME/.local/share/firstmate}
fail() { printf 'ai-acct: %s\n' "$*" >&2; exit 1; }
usage() {
    cat <<'HELP'
Usage: ai-acct [status | use a|b | resume | exec COMMAND [ARG...] | --help]
  status   Show the active Claude account and Claude/Codex quota.
  use a|b  Select a local token for future launches and tmux panes.
  resume   Continue Claude in ${FM_HOME:-~/.local/share/firstmate}.
  exec     Run a command with the active token and shared Claude config.
Store tokens in ~/.config/claude-accounts/{a,b}.token with mode 600.
Running processes retain their account until relaunched.
HELP
}
read_active() {
    account=''
    [ ! -e "$accounts/active" ] || account=$(cat "$accounts/active") || fail 'Cannot read active selector.'
    case "$account" in ''|a|b) ;; *) fail 'Invalid active selector; use ai-acct use a|b.' ;; esac
}
load_token() {
    case "$account" in a|b) ;; *) fail 'No active account; use ai-acct use a|b.' ;; esac
    file=$accounts/$account.token
    [ -f "$file" ] && [ -r "$file" ] || fail 'Token missing or unreadable; install the account token first.'
    mode=$(stat -c %a "$file" 2>/dev/null) || mode=$(stat -f %Lp "$file") || fail 'Cannot check token permissions.'
    [ "$mode" = 600 ] || fail 'Token must have mode 600 (chmod 600 the token file).'
    token=$(cat "$file") || fail 'Cannot read token.'
    case "$token" in ''|*[![:graph:]]*) fail 'Token must contain one nonempty line without whitespace.' ;; esac
    unset CLAUDE_CONFIG_DIR ANTHROPIC_API_KEY
    CLAUDE_CODE_OAUTH_TOKEN=$token
    export CLAUDE_CODE_OAUTH_TOKEN
}
ensure_onboarding() (
    # Preserve all existing settings; never replace malformed user config.
    umask 077
    command -v jq >/dev/null 2>&1 || fail 'jq is required to update ~/.claude.json.'
    config=$HOME/.claude.json
    tmp=$(mktemp "$HOME/.claude.json.XXXXXX") || fail 'Cannot prepare shared config.'
    trap 'rm -f "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM
    if [ -e "$config" ]; then
        jq -e 'if type == "object" then .hasCompletedOnboarding = true else error("Expected object") end' \
            "$config" > "$tmp" 2>/dev/null || fail 'Cannot update ~/.claude.json; expected a JSON object.'
    else
        printf '{"hasCompletedOnboarding":true}\n' > "$tmp"
    fi
    mv -f "$tmp" "$config" || fail 'Cannot save shared config.'
)
case "${1:-status}" in
    --help|-h) usage ;;
    status)
        [ "$#" -le 1 ] || fail 'status takes no arguments.'
        read_active
        if [ -n "$account" ]; then
            load_token
            case "$account" in a) label=A ;; b) label=B ;; esac
            printf 'Claude account: %s\n' "$label"
        else
            printf 'Claude account: unconfigured\n'
        fi
        exec quota-axi --provider claude,codex
        ;;
    use)
        [ "$#" -eq 2 ] || fail 'Use: ai-acct use a|b'
        account=$2
        load_token
        ensure_onboarding
        umask 077
        tmp=$(mktemp "$accounts/.active.XXXXXX") || fail 'Cannot prepare selector.'
        trap 'rm -f "$tmp"' EXIT
        trap 'exit 1' HUP INT TERM
        printf '%s\n' "$account" > "$tmp"
        mv -f "$tmp" "$accounts/active" || fail 'Cannot save selector.'
        if [ -n "${TMUX:-}" ]; then
            # Single-quoted command on stdin: the token never enters the tmux client's argv.
            quoted=$(printf '%s' "$token" | sed "s/\\\\/\\\\\\\\/g; s/'/\\\\'/g")
            printf "set-environment -g CLAUDE_CODE_OAUTH_TOKEN '%s'\nset-environment -gu CLAUDE_CONFIG_DIR\nset-environment -gu ANTHROPIC_API_KEY\n" "$quoted" \
                | tmux || fail 'Selector saved, but tmux token update failed.'
        fi
        printf 'Selected Claude account %s for future launches.\nRunning processes keep their account; ai-acct resume continues the main session.\n' "$account"
        ;;
    resume|exec)
        action=$1
        shift
        if [ "$action" = resume ]; then
            [ "$#" -eq 0 ] || fail 'resume takes no arguments.'
            cd "$fm_home" || fail 'Firstmate home does not exist.'
            set -- claude --continue
        else
            [ "$#" -gt 0 ] || fail 'Use: ai-acct exec COMMAND [ARG...]'
        fi
        read_active
        load_token
        ensure_onboarding
        exec "$@"
        ;;
    *) usage >&2; exit 2 ;;
esac
