#!/usr/bin/env python3
"""Sanitized quota views: menus never block, status waits briefly.
Credentials stay in ai-acct's child env; the only parent-side use of a token
file is a one-way fingerprint to match statusline captures to their account."""
import datetime as dt
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

ACCT = Path(__file__).resolve().with_name('ai-acct')
CACHE = Path(os.environ.get('XDG_CACHE_HOME', str(Path.home() / '.cache'))) / 'ai-acct'
TTL = 300
RATE_TTL = 900
MAX_RATE_TTL = 3600
WAIT = 12
BAR = 20
COMPACT_BAR = 10
# Claude Code's statusline rate_limits windows, named like quota-axi's.
STATUSLINE_WINDOWS = (('five_hour', 'session'), ('seven_day', 'week'))
UNKNOWN = {'state': 'unknown', 'percent': None, 'reset': None, 'windows': []}


def identity(provider, name):
    if provider == 'codex':
        path = Path(os.environ.get('CODEX_HOME', str(Path.home() / '.codex'))) / 'auth.json'
    else:
        path = Path.home() / '.config/claude-accounts' / (name + '.token')
    try:
        stat = path.stat()
        return [str(path), stat.st_ino, stat.st_mtime_ns, stat.st_ctime_ns,
                stat.st_size, stat.st_mode]
    except OSError:
        return [str(path), None]


def now():
    # Tests pin the clock so reset and age arithmetic is deterministic.
    return float(os.environ.get('AI_ACCT_NOW') or time.time())


def fingerprint(token):
    # Must match agent-statusline-claude; one-way, so captures never hold a token.
    return hashlib.sha256(b'ai-acct-statusline:' + token.encode()).hexdigest()


def usable(quota):
    return isinstance(quota, dict) and bool(quota.get('windows'))


def cached(path, key):
    try:
        record = json.loads(path.read_text())
        if (record['identity'] == key and isinstance(record['quota'].get('windows'), list)
                and isinstance(record['time'], (int, float))):
            return record
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return None


def fresh(record):
    ttl = TTL
    if record['quota'].get('state') == 'rate-limited':
        retry = reset_time(record['quota'].get('retry'))
        ttl = RATE_TTL if retry is None else min(max(
            dt.datetime.fromisoformat(retry).timestamp() - record['time'], TTL), MAX_RATE_TTL)
    return 0 <= now() - record['time'] < ttl


def number(value):
    return (isinstance(value, (int, float)) and not isinstance(value, bool)
            and math.isfinite(value) and 0 <= value <= 100)


def reset_time(value):
    if not isinstance(value, str):
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
        return parsed.isoformat() if parsed.tzinfo else None
    except ValueError:
        return None


def label(window):
    text = window.get('label')
    if not isinstance(text, str) or not text.isprintable() or not text.strip():
        text = window.get('kind', '')
    return str(text).strip()[:16] or 'quota'


def normalize(data, provider):
    entry = next(p for p in data['providers'] if p['provider'] == provider)
    state = entry.get('state', {})
    if state.get('status') == 'rate_limited' or state.get('retryAfter'):
        return {**UNKNOWN, 'state': 'rate-limited', 'retry': reset_time(state.get('retryAfter'))}
    if state.get('status') != 'fresh':
        raise ValueError('no fresh reading')
    shown = [{'label': label(w), 'percent': w['percentRemaining'],
              'reset': reset_time(w.get('resetsAt'))}
             for w in entry.get('windows', []) if number(w.get('percentRemaining'))]
    windows = [w for w in entry.get('windows', [])
               if w.get('kind') in ('session', 'weekly', 'monthly', 'credits')
               and number(w.get('percentRemaining'))]
    semantics = entry.get('quotaSemantics', {}).get('effectiveAvailability')
    if semantics is not None:
        scope = next((s for s in semantics if s.get('scope') == 'all_models'), {})
        percent = scope.get('effectivePercentRemaining')
        if scope.get('status') == 'unknown' or not number(percent):
            return {**UNKNOWN, 'windows': shown}
        limiting = next((w for w in windows if w.get('id') in scope.get('limitingWindowIds', [])), {})
    elif windows:
        limiting = min(windows, key=lambda w: w['percentRemaining'])
        percent = limiting['percentRemaining']
    else:
        return {**UNKNOWN, 'windows': shown}
    return {'state': 'known', 'percent': percent,
            'reset': reset_time(limiting.get('resetsAt')), 'windows': shown}


def child_env():
    return {k: v for k, v in os.environ.items() if k not in (
        'CLAUDE_CODE_OAUTH_TOKEN', 'ANTHROPIC_API_KEY', 'CLAUDE_CONFIG_DIR',
        'QUOTA_AXI_CLAUDE_PROFILES')}


def refresh(provider, name, path):
    # OS lock is released even on timeout/crash; overlapping menus make one read.
    with path.with_suffix('.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            # Another refresh is in flight; exit when it finishes so waiters see it.
            fcntl.flock(lock, fcntl.LOCK_EX)
            return
        key = identity(provider, name)
        previous = cached(path, key)
        if previous and fresh(previous):
            return
        good = last_good(previous)
        try:
            result = subprocess.run([str(ACCT), '_quota', provider, name],
                                    env=child_env(), stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, timeout=WAIT - 2, text=True)
            # Some providers return useful rate-limit JSON with a nonzero exit.
            quota = normalize(json.loads(result.stdout), provider)
        except (OSError, ValueError, KeyError, TypeError, StopIteration,
                subprocess.TimeoutExpired):
            # Failures are not cached, so the next view retries instead of
            # showing unknown for a whole TTL.
            return
        if identity(provider, name) != key:
            return
        record = {'identity': key, 'time': now(), 'quota': quota}
        # A throttled or empty answer must not erase the last real reading.
        if not usable(quota) and good:
            record['good'] = good
        fd, tmp = tempfile.mkstemp(dir=CACHE, prefix='.quota-')
        try:
            with os.fdopen(fd, 'w') as out:
                json.dump(record, out)
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)


def last_good(record):
    """Newest reading with windows from a cache record, as {'time', 'quota'}."""
    if not record:
        return None
    if usable(record['quota']):
        return {'time': record['time'], 'quota': record['quota']}
    good = record.get('good')
    if (isinstance(good, dict) and usable(good.get('quota'))
            and isinstance(good.get('time'), (int, float))):
        return good
    return None


def cache_path(provider, name):
    return CACHE / (provider + '-' + name + '.json')


def statusline_path(name):
    return CACHE / ('claude-' + name + '.limits.json')


def statusline_reading(name):
    """Rate limits Claude Code gave the statusline of a process using this account."""
    try:
        token = (Path.home() / '.config/claude-accounts' / (name + '.token')).read_text().rstrip('\n')
        record = json.loads(statusline_path(name).read_text())
        taken = record['time']
        if (record['fingerprint'] != fingerprint(token) or not isinstance(taken, (int, float))
                or isinstance(taken, bool) or not -60 <= now() - taken):
            return None
        windows = []
        for kind, text in STATUSLINE_WINDOWS:
            window = record['windows'].get(kind)
            if not isinstance(window, dict) or not number(window.get('used')):
                continue
            reset = window.get('resets_at')
            when_reset = (dt.datetime.fromtimestamp(reset, dt.timezone.utc).isoformat()
                          if isinstance(reset, (int, float)) and not isinstance(reset, bool)
                          and 0 < reset < 1e11 else None)
            windows.append({'label': text, 'percent': 100 - window['used'], 'reset': when_reset})
    except (OSError, ValueError, KeyError, TypeError, AttributeError, UnicodeError):
        return None
    if not windows:
        return None
    limiting = min(windows, key=lambda w: w['percent'])
    quota = {'state': 'known', 'percent': limiting['percent'],
             'reset': limiting['reset'], 'windows': windows}
    return {'time': taken, 'quota': quota}


def read_quota(provider, name):
    """Best available reading: {'quota', 'note'}; note says where old data came from."""
    record = cached(cache_path(provider, name), identity(provider, name))
    if record and fresh(record) and usable(record['quota']):
        return {'quota': record['quota'], 'note': ''}
    candidates = []
    older = last_good(record)
    if older:
        candidates.append((older['time'], older['quota'], 'stale'))
    if provider == 'claude':
        live = statusline_reading(name)
        if live:
            candidates.append((live['time'], live['quota'], 'via statusline'))
    if candidates:
        taken, quota, source = max(candidates, key=lambda c: c[0])
        return {'quota': settled(quota), 'note': f'{source}, {ago(now() - taken)}'}
    return {'quota': record['quota'] if record else UNKNOWN, 'note': ''}


def passed(item):
    reset = reset_time(item.get('reset'))
    return bool(reset) and dt.datetime.fromisoformat(reset).timestamp() <= now()


def settled(quota):
    """An old reading says nothing about windows that have reset since it was taken."""
    windows = [{**w, 'percent': 100, 'reset': None, 'renewed': True}
               if isinstance(w, dict) and passed(w) else w for w in quota['windows']]
    if not passed(quota):
        return {**quota, 'windows': windows}
    live = [w for w in usable_windows({'windows': windows}) if not w.get('renewed')]
    limiting = min(live, key=lambda w: w['percent'], default={'percent': 100, 'reset': None})
    return {**quota, 'state': 'known', 'percent': limiting['percent'],
            'reset': limiting['reset'], 'windows': windows}


def is_fresh(provider, name):
    record = cached(cache_path(provider, name), identity(provider, name))
    return bool(record and fresh(record))


def start_refresh(provider, name):
    if is_fresh(provider, name):
        return None
    return subprocess.Popen([sys.executable, str(Path(__file__).resolve()),
                             '_refresh', provider, name], env=child_env(),
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)


def wait_fresh(targets):
    # The full view waits a bounded time; refreshes keep running after a timeout.
    pending = [p for p in (start_refresh(*t) for t in targets) if p]
    deadline = time.monotonic() + WAIT
    while pending and time.monotonic() < deadline:
        time.sleep(0.1)
        pending = [p for p in pending if p.poll() is None]


def color_enabled():
    if 'NO_COLOR' in os.environ:
        return False
    # Menus capture the listing through a pipe, then show it in an ANSI-aware fzf.
    return sys.stdout.isatty() or os.environ.get('AI_ACCT_COLOR') == '1'


STYLES = {'green': 32, 'yellow': 33, 'red': 31, 'dim': 90, 'bold': 1}


def paint(text, style):
    if not style or not color_enabled():
        return text
    return f'\033[{STYLES[style]}m{text}\033[0m'


def level(percent):
    return 'green' if percent >= 50 else 'yellow' if percent >= 20 else 'red'


def bar_cells(percent, width):
    filled = round(percent / 100 * width)
    return [('█' * filled, level(percent)), ('░' * (width - filled), 'dim')]


def percent_cell(percent):
    return (f'{percent:3.0f}% left', level(percent))


def compose(cells):
    return ''.join(paint(text, style) for text, style in cells)


def bar(percent):
    return compose(bar_cells(percent, COMPACT_BAR) + [(' ', None), percent_cell(percent)])


def when(value):
    value = reset_time(value)
    if not value:
        return ''
    return dt.datetime.fromisoformat(value).astimezone().strftime('%b %d %H:%M %Z')


def ago(seconds):
    minutes = max(int(seconds), 0) // 60
    if minutes < 1:
        return 'just now'
    if minutes < 60:
        return f'{minutes}m ago'
    if minutes < 48 * 60:
        return f'{minutes // 60}h ago'
    return f'{minutes // 1440}d ago'


def until(value):
    value = reset_time(value)
    if not value or dt.datetime.fromisoformat(value).timestamp() <= now():
        return ''
    moment = dt.datetime.fromisoformat(value).astimezone()
    same_day = moment.date() == dt.datetime.fromtimestamp(now()).astimezone().date()
    return moment.strftime('%H:%M' if same_day else '%b %d %H:%M %Z')


def unavailable(quota):
    """Say the quota could not be read; never imply the account is out of quota."""
    if quota.get('state') == 'rate-limited':
        retry = until(quota.get('retry'))
        return '◌ could not read quota - usage API limited' + (f' until {retry}' if retry else '')
    return '◌ unknown'


def render(view):
    quota, note = view['quota'], view['note']
    percent = quota.get('percent')
    if quota.get('state') != 'known' or not number(percent):
        return unavailable(quota)
    return bar(percent) + (paint(f'  ({note})', 'dim') if note else '')


def usable_windows(quota):
    return [w for w in quota.get('windows') or [] if isinstance(w, dict)
            and isinstance(w.get('label'), str) and number(w.get('percent'))]


def box(titles_and_rows):
    """Frame every account with one shared width so the boxes line up."""
    def plain(cells):
        return ''.join(text for text, _ in cells)
    inner = max(max([len(plain(row)) + 2 for row in rows] + [len(plain(title)) + 3])
                for title, rows in titles_and_rows)
    edge = lambda text: (text, 'dim')
    lines = []
    for title, rows in titles_and_rows:
        fill = '─' * (inner - 3 - len(plain(title)))
        lines.append(compose([edge('╭─ '), *title, edge(' ' + fill + '╮')]))
        for row in rows:
            pad = ' ' * (inner - 2 - len(plain(row)))
            lines.append(compose([edge('│ '), *row, (pad, None), edge(' │')]))
        lines.append(compose([edge('╰' + '─' * inner + '╯')]))
    return lines


def account_box(title, view, labels):
    quota, note = view['quota'], view['note']
    windows = usable_windows(quota)
    heading = [(title, 'bold')]
    if not windows:
        return heading, [[(unavailable(quota), 'yellow')]]
    rows = []
    for window in windows:
        reset = 'reset since last reading' if window.get('renewed') else when(window.get('reset'))
        rows.append([(window['label'].ljust(labels), None), (' ', None),
                     *bar_cells(window['percent'], BAR), (' ', None),
                     percent_cell(window['percent'])]
                    + ([('  ', None), (f'↻ {reset}', 'dim')] if reset else []))
    if note:
        rows.append([(f'⟳ {note}', 'yellow')])
    return heading, rows


def render_full(entries):
    labels = max([len(w['label']) for _, view in entries
                  for w in usable_windows(view['quota'])] + [4])
    return box([account_box(title, view, labels) for title, view in entries])


def main():
    os.umask(0o077)
    CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
    CACHE.chmod(0o700)
    if sys.argv[1] == '_refresh':
        provider, name = sys.argv[2:]
        # Only names emitted by ai-acct list can become cache paths.
        if provider not in ('claude', 'codex') or not name or len(name) > 32:
            return
        if not name[0].isascii() or not all(c in 'abcdefghijklmnopqrstuvwxyz0123456789_-' for c in name):
            return
        refresh(provider, name, cache_path(provider, name))
        return
    listing = subprocess.run([str(ACCT), 'list'], stdout=subprocess.PIPE, text=True)
    if listing.returncode:
        sys.exit(listing.returncode)
    rows = [line.split('\t') for line in listing.stdout.splitlines()]
    targets = [('claude', name) for name, _ in rows]
    if sys.argv[1] == 'list':
        for (name, state), target in zip(rows, targets):
            start_refresh(*target)
            print(f'{name}\t{state}\t{render(read_quota(*target))}')
        return
    targets.append(('codex', 'default'))
    wait_fresh(targets)
    entries = [('✦ Claude ' + name + (' (active)' if state == 'active' else ''), read_quota(*target))
               for (name, state), target in zip(rows, targets)]
    if not rows:
        print('Claude account: unconfigured')
    entries.append(('◆ Codex', read_quota('codex', 'default')))
    print('\n'.join(render_full(entries)))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError):
        # Never forward raw subprocess diagnostics or arbitrary JSON fields.
        print('ai-acct: quota unavailable (check cache permissions)', file=sys.stderr)
        sys.exit(1)
