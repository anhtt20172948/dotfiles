#!/bin/bash
set -euo pipefail

# Clean up only the files this run created, even when interrupted.
BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/install_zsh.XXXXXXXX")
trap 'rm -rf -- "$BUILD_DIR"' EXIT
trap 'echo "Install failed at line $LINENO." >&2' ERR
trap 'exit 130' INT
trap 'exit 143' TERM
cd "$BUILD_DIR"

# Bound each download and try fallback sources when a server does not answer.
download() {
    local output=$1 url
    shift
    for url in "$@"; do
        echo "Downloading: $url"
        if timeout 120s wget --timeout=15 --tries=2 --show-progress -O "$output" "$url"; then
            return 0
        fi
        echo "Could not download from $url; trying the next source if any." >&2
    done
    echo "Could not download $output. Check the network and run again." >&2
    return 1
}

# Standard .local directory layout
mkdir -p "$HOME/.local/bin" "$HOME/.local/include" "$HOME/.local/lib" "$HOME/.local/lib/pkgconfig"

# Build flags pointing at .local
export CXXFLAGS="-fPIC" 
export CFLAGS="-fPIC" 
export CPPFLAGS="-I${HOME}/.local/include" 
export LDFLAGS="-L${HOME}/.local/lib"
export PKG_CONFIG_PATH="$HOME/.local/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
export PATH="$HOME/.local/bin:$PATH"

# CPU cores for a parallel build
NUM_CORES=$(nproc 2>/dev/null || echo 2)

# ==========================================
# 1. INSTALL NCURSES (with pkg-config support)
# ==========================================
echo "--- Downloading and installing ncurses into ~/.local ---"
download ncurses-6.5.tar.gz \
    https://mirrors.kernel.org/gnu/ncurses/ncurses-6.5.tar.gz \
    https://ftp.gnu.org/pub/gnu/ncurses/ncurses-6.5.tar.gz
tar -xzvf ncurses-6.5.tar.gz
cd ncurses-6.5

./configure --prefix="$HOME/.local" \
            --enable-shared \
            --with-shared \
            --enable-pc-files \
            --with-pkg-config-libdir="$HOME/.local/lib/pkgconfig" \
            --without-cxx \
            --without-cxx-binding \
            --enable-widec # wide-character (UTF-8) support

make -j"$NUM_CORES"
make install

# Symlink libncursesw (wide) to plain libncurses so zsh finds it
cd "$HOME/.local/lib"
ln -sf libncursesw.so libncurses.so
ln -sf libncursesw.a libncurses.a

cd "$BUILD_DIR"

# ==========================================
# 2. INSTALL ZSH (with explicit library lookup flags)
# ==========================================
echo "--- Downloading and installing zsh into ~/.local ---"
download zsh.tar.xz https://sourceforge.net/projects/zsh/files/latest/download
mkdir -p zsh_src
tar -xJf zsh.tar.xz -C zsh_src --strip-components 1
cd zsh_src

# Point at ncurses explicitly through the extended flags
./configure --prefix="$HOME/.local" \
            --enable-multibyte \
            --with-term-lib="ncurses" \
            CPPFLAGS="-I${HOME}/.local/include -I${HOME}/.local/include/ncursesw -I${HOME}/.local/include/ncurses" \
            LDFLAGS="-L${HOME}/.local/lib -Wl,-rpath,${HOME}/.local/lib"

make -j"$NUM_CORES"
make install
cd "$BUILD_DIR"

# ==========================================
# 3. STARTUP CONFIG (BASH TO ZSH)
# ==========================================
echo "--- Configuring the automatic shell switch ---"

if ! grep -q "exec ~/.local/bin/zsh" ~/.bash_profile 2>/dev/null; then
    cat << 'EOF' >> ~/.bash_profile

# Add .local/bin to PATH when missing
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# Switch to the zsh installed in .local
if [[ $- == *i* ]] && [ -x "$HOME/.local/bin/zsh" ]; then
    export SHELL=$HOME/.local/bin/zsh
    exec "$HOME/.local/bin/zsh" -l
fi
EOF
    echo "Added the zsh config to ~/.bash_profile"
else
    echo "The zsh config is already in ~/.bash_profile."
fi

echo "--- DONE ---"
echo "Now run: source ~/.bash_profile"

