#!/usr/bin/env bash
# Installs kunchenguid's agent workflow on the HOST:
#   treehouse   - reusable git worktree pool (Go binary)
#   no-mistakes - local git remote gating pushes: review -> test -> lint -> PR -> CI fix
#   gnhf        - overnight agent loop, one commit per iteration
#   firstmate   - orchestrator: a main agent spawns crewmates in tmux windows
#   AXI skills  - gh-axi, chrome-devtools-axi, lavish-axi (skills only, NO hooks)
#
# Idempotent: tools already at the right version are skipped. --update reinstalls the pins.
# Config (install.sh): ~/.config/treehouse/config.toml, ~/.no-mistakes/config.yaml,
# ~/.gnhf/config.yml. Keys: tmux prefix F / N, nvim <leader>ap/aP/ag/aW/aF.
set -euo pipefail

TREEHOUSE_VER="3.1.2"
NO_MISTAKES_VER="1.84.0"
GNHF_VER="0.1.51"
# Pin a commit rather than following main: firstmate is a repo of AGENTS.md + scripts, main changes
# daily and can change agent behavior without notice.
FIRSTMATE_REV="${FIRSTMATE_REV:-20dcbf91520b1816663b81873ad67d0b93b3e4d6}"
FIRSTMATE_DIR="${FIRSTMATE_DIR:-$HOME/.local/share/firstmate}"
FIRSTMATE_REPO="${FIRSTMATE_REPO:-https://github.com/kunchenguid/firstmate}"
# <repo>:<skill directory name> - the skill name does not always match the repo name
# (lavish-axi installs as skill "lavish").
AXI_SKILLS="gh-axi:gh-axi chrome-devtools-axi:chrome-devtools-axi lavish-axi:lavish"

BIN_DIR="$HOME/.local/bin"
UPDATE=false

usage() {
	cat <<'EOF'
Usage: install_agent_workflow [--update] [--help]

  --update   reinstall the pinned versions even if already present
EOF
}

while (($#)); do
	case "$1" in
	--update) UPDATE=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	shift
done

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
die() {
	printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
	exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

# --- Dependency checks -------------------------------------
check_deps() {
	local missing=()
	local bin
	for bin in git tmux curl tar node npm npx; do
		have "$bin" || missing+=("$bin")
	done
	# macOS < 15 has no sha256sum, but always has shasum.
	if have sha256sum; then
		SHA256=(sha256sum)
	elif have shasum; then
		SHA256=(shasum -a 256)
	else
		missing+=(sha256sum)
	fi
	((${#missing[@]} == 0)) || die "missing: ${missing[*]}"

	local node_major
	node_major=$(node -p 'process.versions.node.split(".")[0]')
	((node_major >= 20)) || die "node >= 20 required (found $(node --version))"

	local platform
	platform="$(uname -s)-$(uname -m)"
	case "$platform" in
	Linux-x86_64) RELEASE_PLATFORM=linux-amd64 ;;
	Linux-aarch64) RELEASE_PLATFORM=linux-arm64 ;;
	Darwin-x86_64) RELEASE_PLATFORM=darwin-amd64 ;;
	Darwin-arm64) RELEASE_PLATFORM=darwin-arm64 ;;
	*) die "only Linux/macOS x86_64/arm64 are supported (running $platform)" ;;
	esac

	if [[ "$platform" == Darwin-* ]]; then
		export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:/usr/local/opt/coreutils/libexec/gnubin:$PATH"
		if ! realpath --relative-to=/ / >/dev/null 2>&1; then
			have brew || die "tmux-which-key requires GNU realpath: install Homebrew, then brew install coreutils"
			brew install coreutils
			realpath --relative-to=/ / >/dev/null 2>&1 || die "GNU realpath missing; add coreutils libexec/gnubin to PATH"
		fi
	fi

	# gh does not block the install, but no-mistakes / firstmate need it to open PRs.
	if ! have gh; then
		if [[ "$platform" == Darwin-* ]]; then
			warn "'gh' is missing: brew install gh && gh auth login"
		else
			warn "'gh' is missing: sudo pacman -S github-cli && gh auth login"
		fi
	elif ! gh auth status >/dev/null 2>&1; then
		warn "'gh' is not logged in: gh auth login"
	fi
}

# --- Go binaries from GitHub releases, checksum-verified ---
# installed_version <bin>: print the installed version ("" when missing).
installed_version() {
	local bin="$BIN_DIR/$1"
	[[ -x "$bin" ]] || return 0
	"$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
}

install_go_release() {
	local name=$1 ver=$2
	if [[ "$UPDATE" == false && "$(installed_version "$name")" == "$ver" ]]; then
		log "$name v$ver already present, skipping"
		return
	fi

	local base="https://github.com/kunchenguid/$name/releases/download/v$ver"
	local asset="$name-v$ver-$RELEASE_PLATFORM.tar.gz"
	local tmp
	tmp=$(mktemp -d)
	# No trap RETURN: it lingers after the function returns and touches local variables.
	log "downloading $asset"
	if ! curl -fsSL -o "$tmp/$asset" "$base/$asset" ||
		! curl -fsSL -o "$tmp/checksums.txt" "$base/checksums.txt"; then
		rm -rf "$tmp"
		die "downloading $name failed"
	fi

	# Compare the hash by hand instead of `sha256sum -c` to check only this asset's line.
	local want got
	want=$(awk -v f="$asset" '$2 == f || $2 == "*" f { print $1 }' "$tmp/checksums.txt")
	got=$("${SHA256[@]}" "$tmp/$asset" | awk '{ print $1 }')
	if [[ -z "$want" || "$want" != "$got" ]]; then
		rm -rf "$tmp"
		die "checksum mismatch for $asset (want=${want:-?} got=$got)"
	fi

	tar -xzf "$tmp/$asset" -C "$tmp" "$name"
	install -m 0755 "$tmp/$name" "$BIN_DIR/$name"
	rm -rf "$tmp"
	log "$name v$ver -> $BIN_DIR/$name"
}

# --- gnhf (npm) ---------------------------------------------
install_gnhf() {
	if [[ "$UPDATE" == false && "$(installed_version gnhf)" == "$GNHF_VER" ]]; then
		log "gnhf v$GNHF_VER already present, skipping"
	else
		# Force the ~/.local prefix: the system npm's default prefix is /usr -> EACCES.
		log "npm i -g --prefix ~/.local gnhf@$GNHF_VER"
		npm install -g --prefix "$HOME/.local" "gnhf@$GNHF_VER"
	fi
	local resolved
	resolved=$(command -v gnhf || true)
	[[ "$resolved" == "$BIN_DIR/gnhf" ]] ||
		warn "'gnhf' on PATH is ${resolved:-<none>}, not $BIN_DIR/gnhf (v$GNHF_VER); remove the other copy or put $BIN_DIR first on PATH"
}

# --- AXI skills ---------------------------------------------
# Skills only (-g -> ~/.claude/skills ...). Deliberately does NOT run `<tool> setup hooks`:
# each one adds a SessionStart hook on top of ECC's, costing context every session.
install_axi_skills() {
	local pair repo skill
	for pair in $AXI_SKILLS; do
		repo=${pair%%:*}
		skill=${pair#*:}
		# The skills CLI puts the original in ~/.agents/skills and symlinks it to each agent.
		if [[ "$UPDATE" == false && (-d "$HOME/.agents/skills/$skill" || -d "$HOME/.claude/skills/$skill") ]]; then
			log "skill $skill already present, skipping"
			continue
		fi
		log "npx skills add kunchenguid/$repo -g"
		npx -y skills add "kunchenguid/$repo" -g -y ||
			warn "installing skill $repo failed (skipped, run again later)"
	done
}

# --- firstmate (git checkout, pin commit) -------------------
# install.sh links config/ and data/ into $FIRSTMATE_DIR before the clone, so the
# directory can exist without a .git and `git clone` into it would fail. Prints every entry
# that is NOT a symlink into this repo (a real file, a link pointing elsewhere), one
# path per line.
foreign_entries() {
	local dir=$1 entry
	while IFS= read -r -d '' entry; do
		if [[ -L "$entry" && "$(readlink -f "$entry")" == "$REPO_DIR"/* ]]; then
			continue
		fi
		printf '%s\n' "$entry"
	done < <(find "$dir" -mindepth 1 ! -type d -print0)
}

# Clone into a sibling directory, then move .git over: the dotfiles links stay as they are,
# nothing is deleted or overwritten. Never rm -rf $FIRSTMATE_DIR.
adopt_firstmate_dir() {
	local foreign
	foreign=$(foreign_entries "$FIRSTMATE_DIR")
	if [[ -n "$foreign" ]]; then
		warn "$FIRSTMATE_DIR exists, has no .git and holds things that are not dotfiles links, skipping the firstmate clone:"
		printf '  %s\n' "${foreign//$'\n'/$'\n'  }" >&2
		warn "move or delete the paths above (or all of $FIRSTMATE_DIR if unneeded), then run again"
		return 1
	fi

	local tmp link rel
	tmp=$(mktemp -d "$FIRSTMATE_DIR.clone.XXXXXX")
	if ! git clone --quiet --no-checkout "$FIRSTMATE_REPO" "$tmp/repo"; then
		rm -rf "$tmp"
		die "cloning firstmate failed"
	fi
	# A link sitting exactly on a file firstmate tracks would be overwritten by the checkout.
	while IFS= read -r -d '' link; do
		rel=${link#"$FIRSTMATE_DIR"/}
		if [[ -n "$(git -C "$tmp/repo" ls-tree --name-only HEAD -- "$rel")" ]]; then
			rm -rf "$tmp"
			warn "$link collides with a path firstmate tracks, skipping the firstmate clone; move that link away and run again"
			return 1
		fi
	done < <(find "$FIRSTMATE_DIR" -mindepth 1 -type l -print0)

	mv "$tmp/repo/.git" "$FIRSTMATE_DIR/.git"
	rm -rf "$tmp"
	# The index is empty: rebuild it from HEAD, then write only the missing files (checkout-index
	# without -f never overwrites anything).
	git -C "$FIRSTMATE_DIR" reset --quiet
	git -C "$FIRSTMATE_DIR" checkout-index --all
}

install_firstmate() {
	if [[ ! -d "$FIRSTMATE_DIR/.git" ]]; then
		log "clone firstmate -> $FIRSTMATE_DIR"
		mkdir -p "$(dirname "$FIRSTMATE_DIR")"
		if [[ -d "$FIRSTMATE_DIR" ]]; then
			adopt_firstmate_dir || return 0
		else
			git clone --quiet "$FIRSTMATE_REPO" "$FIRSTMATE_DIR"
		fi
	elif [[ "$UPDATE" == true ]]; then
		git -C "$FIRSTMATE_DIR" fetch --quiet origin
	fi

	local head
	head=$(git -C "$FIRSTMATE_DIR" rev-parse HEAD)
	if [[ "$head" == "$FIRSTMATE_REV" ]]; then
		log "firstmate @ ${FIRSTMATE_REV:0:7} already present, skipping"
		return
	fi
	# firstmate writes state (projects/, data/) into its own checkout -> do not check out
	# over a dirty tree, so its state is never lost.
	if [[ -n "$(git -C "$FIRSTMATE_DIR" status --porcelain --untracked-files=no)" ]]; then
		warn "firstmate has uncommitted changes, keeping @ ${head:0:7}"
		return
	fi
	git -C "$FIRSTMATE_DIR" fetch --quiet origin "$FIRSTMATE_REV" 2>/dev/null || true
	git -C "$FIRSTMATE_DIR" -c advice.detachedHead=false checkout --quiet "$FIRSTMATE_REV"
	log "firstmate -> ${FIRSTMATE_REV:0:7}"
}

# --- State directories must be REAL directories -------------
# Old stow installs: a directory missing at stow time got folded into one symlink into
# dotfiles, and the tools' DBs/worktrees/run logs landed in the repo (install.sh does not
# fold these directories). Only removes a symlink pointing into THIS
# repo (a symlink you set up elsewhere is kept), creates a real directory, then relinks
# each file in the shape stow makes: "../<target of the folded symlink>/<name>".
REPO_DIR=$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")

unfold_dir() {
	local dir=$1 target src entry name
	if [[ ! -L "$dir" ]]; then
		mkdir -p "$dir"
		return
	fi
	if [[ "$(readlink -f "$dir")" != "$REPO_DIR/${dir#"$HOME"/}" ]]; then
		warn "$dir is a symlink not pointing into $REPO_DIR, keeping it"
		return
	fi
	target=$(readlink "$dir")
	[[ "$target" == /* ]] || target="../$target"
	src=$(readlink -f "$dir")
	log "splitting $dir out of the stow symlink"
	rm "$dir"
	mkdir -p "$dir"
	for entry in "$src"/* "$src"/.[!.]*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name=${entry##*/}
		ln -s "$target/$name" "$dir/$name"
	done
}

main() {
	check_deps
	mkdir -p "$BIN_DIR"
	unfold_dir "$HOME/.no-mistakes"
	unfold_dir "$HOME/.gnhf"
	unfold_dir "$HOME/.config/treehouse"
	install_go_release treehouse "$TREEHOUSE_VER"
	install_go_release no-mistakes "$NO_MISTAKES_VER"
	install_gnhf
	install_axi_skills
	install_firstmate

	cat <<EOF

Done. Next steps:
  1. relink dotfiles to get the config: ~/dotfiles/install.sh
  2. In every repo whose pushes should be gated: no-mistakes init
  3. Check: no-mistakes doctor
  4. tmux: prefix F (workflow menu), prefix N (no-mistakes TUI)
EOF
}

# Lets tests `source` this file without running the whole installer.
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
