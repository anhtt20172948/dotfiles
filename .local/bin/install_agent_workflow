#!/usr/bin/env bash
# Cài bộ agent workflow của kunchenguid lên HOST:
#   treehouse   - pool git worktree tái dùng (binary Go)
#   no-mistakes - git remote cục bộ chặn push: review -> test -> lint -> PR -> CI fix
#   gnhf        - vòng lặp agent chạy qua đêm, mỗi iteration một commit
#   firstmate   - orchestrator: agent chính sinh crewmate trong tmux window
#   AXI skills  - gh-axi, chrome-devtools-axi, lavish-axi (chỉ skill, KHÔNG hooks)
#
# Idempotent: tool nào đã đúng version thì bỏ qua. --update để cài lại bản pin.
# Config (install.sh): ~/.config/treehouse/config.toml, ~/.no-mistakes/config.yaml,
# ~/.gnhf/config.yml. Phím: tmux prefix F / N, nvim <leader>ap/aP/ag/aW/aF.
set -euo pipefail

TREEHOUSE_VER="3.1.2"
NO_MISTAKES_VER="1.84.0"
GNHF_VER="0.1.51"
# Pin commit chứ không theo main: firstmate là repo AGENTS.md + script, main đổi
# hằng ngày và có thể đổi hành vi của agent mà không báo.
FIRSTMATE_REV="${FIRSTMATE_REV:-20dcbf91520b1816663b81873ad67d0b93b3e4d6}"
FIRSTMATE_DIR="${FIRSTMATE_DIR:-$HOME/.local/share/firstmate}"
FIRSTMATE_REPO="${FIRSTMATE_REPO:-https://github.com/kunchenguid/firstmate}"
# <repo>:<tên thư mục skill> - tên skill không luôn trùng tên repo
# (lavish-axi cài thành skill "lavish").
AXI_SKILLS="gh-axi:gh-axi chrome-devtools-axi:chrome-devtools-axi lavish-axi:lavish"

BIN_DIR="$HOME/.local/bin"
UPDATE=false

usage() {
	cat <<'EOF'
Usage: install_agent_workflow [--update] [--help]

  --update   cài lại các bản đã pin dù đã có sẵn
EOF
}

while (($#)); do
	case "$1" in
	--update) UPDATE=true ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	shift
done

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
die() {
	printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
	exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

# --- Kiểm tra phụ thuộc -------------------------------------
check_deps() {
	local missing=()
	local bin
	for bin in git tmux curl tar node npm npx; do
		have "$bin" || missing+=("$bin")
	done
	# macOS < 15 không có sha256sum, nhưng luôn có shasum.
	if have sha256sum; then
		SHA256=(sha256sum)
	elif have shasum; then
		SHA256=(shasum -a 256)
	else
		missing+=(sha256sum)
	fi
	((${#missing[@]} == 0)) || die "thiếu: ${missing[*]}"

	local node_major
	node_major=$(node -p 'process.versions.node.split(".")[0]')
	((node_major >= 20)) || die "cần node >= 20 (đang có $(node --version))"

	local platform
	platform="$(uname -s)-$(uname -m)"
	case "$platform" in
	Linux-x86_64) RELEASE_PLATFORM=linux-amd64 ;;
	Linux-aarch64) RELEASE_PLATFORM=linux-arm64 ;;
	Darwin-x86_64) RELEASE_PLATFORM=darwin-amd64 ;;
	Darwin-arm64) RELEASE_PLATFORM=darwin-arm64 ;;
	*) die "chỉ hỗ trợ Linux/macOS x86_64/arm64 (đang chạy $platform)" ;;
	esac

	# gh không chặn việc cài, nhưng no-mistakes / firstmate cần nó để mở PR.
	if ! have gh; then
		if [[ "$platform" == Darwin-* ]]; then
			warn "chưa có 'gh': brew install gh && gh auth login"
		else
			warn "chưa có 'gh': sudo pacman -S github-cli && gh auth login"
		fi
	elif ! gh auth status >/dev/null 2>&1; then
		warn "'gh' chưa đăng nhập: gh auth login"
	fi
}

# --- Binary Go từ GitHub release, có kiểm checksum ---------
# installed_version <bin>: in version đang cài ("" nếu chưa có).
installed_version() {
	local bin="$BIN_DIR/$1"
	[[ -x "$bin" ]] || return 0
	"$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
}

install_go_release() {
	local name=$1 ver=$2
	if [[ "$UPDATE" == false && "$(installed_version "$name")" == "$ver" ]]; then
		log "$name v$ver đã có, bỏ qua"
		return
	fi

	local base="https://github.com/kunchenguid/$name/releases/download/v$ver"
	local asset="$name-v$ver-$RELEASE_PLATFORM.tar.gz"
	local tmp
	tmp=$(mktemp -d)
	# Không dùng trap RETURN: nó còn dính sau khi hàm return và đụng biến local.
	log "tải $asset"
	if ! curl -fsSL -o "$tmp/$asset" "$base/$asset" ||
		! curl -fsSL -o "$tmp/checksums.txt" "$base/checksums.txt"; then
		rm -rf "$tmp"
		die "tải $name thất bại"
	fi

	# Tự so hash thay vì `sha256sum -c` để chỉ kiểm đúng một dòng của asset này.
	local want got
	want=$(awk -v f="$asset" '$2 == f || $2 == "*" f { print $1 }' "$tmp/checksums.txt")
	got=$("${SHA256[@]}" "$tmp/$asset" | awk '{ print $1 }')
	if [[ -z "$want" || "$want" != "$got" ]]; then
		rm -rf "$tmp"
		die "checksum $asset không khớp (want=${want:-?} got=$got)"
	fi

	tar -xzf "$tmp/$asset" -C "$tmp" "$name"
	install -m 0755 "$tmp/$name" "$BIN_DIR/$name"
	rm -rf "$tmp"
	log "$name v$ver -> $BIN_DIR/$name"
}

# --- gnhf (npm) ---------------------------------------------
install_gnhf() {
	if [[ "$UPDATE" == false && "$(installed_version gnhf)" == "$GNHF_VER" ]]; then
		log "gnhf v$GNHF_VER đã có, bỏ qua"
	else
		# Ép prefix ~/.local: prefix mặc định của npm hệ thống là /usr -> EACCES.
		log "npm i -g --prefix ~/.local gnhf@$GNHF_VER"
		npm install -g --prefix "$HOME/.local" "gnhf@$GNHF_VER"
	fi
	local resolved
	resolved=$(command -v gnhf || true)
	[[ "$resolved" == "$BIN_DIR/gnhf" ]] ||
		warn "'gnhf' trên PATH là ${resolved:-<không có>}, không phải $BIN_DIR/gnhf (v$GNHF_VER); gỡ bản kia hoặc đưa $BIN_DIR lên trước PATH"
}

# --- AXI skills ---------------------------------------------
# Chỉ cài skill (-g -> ~/.claude/skills ...). Cố ý KHÔNG chạy `<tool> setup hooks`:
# mỗi cái thêm một SessionStart hook chồng lên hook của ECC, tốn context mỗi phiên.
install_axi_skills() {
	local pair repo skill
	for pair in $AXI_SKILLS; do
		repo=${pair%%:*}
		skill=${pair#*:}
		# skills CLI đặt bản gốc ở ~/.agents/skills rồi symlink sang từng agent.
		if [[ "$UPDATE" == false && (-d "$HOME/.agents/skills/$skill" || -d "$HOME/.claude/skills/$skill") ]]; then
			log "skill $skill đã có, bỏ qua"
			continue
		fi
		log "npx skills add kunchenguid/$repo -g"
		npx -y skills add "kunchenguid/$repo" -g -y ||
			warn "cài skill $repo thất bại (bỏ qua, chạy lại sau)"
	done
}

# --- firstmate (git checkout, pin commit) -------------------
# install.sh đã link config/ và data/ vào $FIRSTMATE_DIR trước khi clone, nên thư
# mục có thể tồn tại mà chưa có .git và `git clone` vào đó sẽ lỗi. Entry nào
# KHÔNG phải symlink trỏ vào repo này (file thật, link trỏ chỗ khác): in ra, mỗi
# dòng một đường dẫn.
foreign_entries() {
	local dir=$1 entry
	while IFS= read -r -d '' entry; do
		if [[ -L "$entry" && "$(readlink -f "$entry")" == "$REPO_DIR"/* ]]; then
			continue
		fi
		printf '%s\n' "$entry"
	done < <(find "$dir" -mindepth 1 ! -type d -print0)
}

# Clone vào thư mục cạnh rồi chuyển .git sang: các link của dotfiles giữ nguyên,
# không xoá hay ghi đè gì. Không bao giờ rm -rf $FIRSTMATE_DIR.
adopt_firstmate_dir() {
	local foreign
	foreign=$(foreign_entries "$FIRSTMATE_DIR")
	if [[ -n "$foreign" ]]; then
		warn "$FIRSTMATE_DIR đã tồn tại, chưa có .git và chứa thứ không phải link của dotfiles, bỏ qua clone firstmate:"
		printf '  %s\n' "${foreign//$'\n'/$'\n'  }" >&2
		warn "dời hoặc xoá các đường dẫn trên (hoặc cả $FIRSTMATE_DIR nếu không cần), rồi chạy lại"
		return 1
	fi

	local tmp link rel
	tmp=$(mktemp -d "$FIRSTMATE_DIR.clone.XXXXXX")
	if ! git clone --quiet --no-checkout "$FIRSTMATE_REPO" "$tmp/repo"; then
		rm -rf "$tmp"
		die "clone firstmate thất bại"
	fi
	# Link nằm đúng chỗ file mà firstmate track thì checkout sẽ đè mất link.
	while IFS= read -r -d '' link; do
		rel=${link#"$FIRSTMATE_DIR"/}
		if [[ -n "$(git -C "$tmp/repo" ls-tree --name-only HEAD -- "$rel")" ]]; then
			rm -rf "$tmp"
			warn "$link trùng đường dẫn firstmate track, bỏ qua clone firstmate; dời link đó đi rồi chạy lại"
			return 1
		fi
	done < <(find "$FIRSTMATE_DIR" -mindepth 1 -type l -print0)

	mv "$tmp/repo/.git" "$FIRSTMATE_DIR/.git"
	rm -rf "$tmp"
	# Index đang trống: dựng lại từ HEAD rồi chỉ ghi file còn thiếu (checkout-index
	# không có -f sẽ không đè gì có sẵn).
	git -C "$FIRSTMATE_DIR" reset --quiet
	git -C "$FIRSTMATE_DIR" checkout-index --all
}

install_firstmate() {
	if [[ ! -d "$FIRSTMATE_DIR/.git" ]]; then
		log "clone firstmate -> $FIRSTMATE_DIR"
		mkdir -p "$(dirname "$FIRSTMATE_DIR")"
		if [[ -d "$FIRSTMATE_DIR" ]]; then
			adopt_firstmate_dir || return 0
		else
			git clone --quiet "$FIRSTMATE_REPO" "$FIRSTMATE_DIR"
		fi
	elif [[ "$UPDATE" == true ]]; then
		git -C "$FIRSTMATE_DIR" fetch --quiet origin
	fi

	local head
	head=$(git -C "$FIRSTMATE_DIR" rev-parse HEAD)
	if [[ "$head" == "$FIRSTMATE_REV" ]]; then
		log "firstmate @ ${FIRSTMATE_REV:0:7} đã có, bỏ qua"
		return
	fi
	# firstmate ghi state (projects/, data/) vào chính checkout -> không checkout
	# đè khi cây đang bẩn, tránh mất state của nó.
	if [[ -n "$(git -C "$FIRSTMATE_DIR" status --porcelain --untracked-files=no)" ]]; then
		warn "firstmate có thay đổi chưa commit, giữ nguyên @ ${head:0:7}"
		return
	fi
	git -C "$FIRSTMATE_DIR" fetch --quiet origin "$FIRSTMATE_REV" 2>/dev/null || true
	git -C "$FIRSTMATE_DIR" -c advice.detachedHead=false checkout --quiet "$FIRSTMATE_REV"
	log "firstmate -> ${FIRSTMATE_REV:0:7}"
}

# --- Thư mục state phải là thư mục THẬT ---------------------
# Bản cài bằng stow cũ: thư mục chưa có lúc stow bị gập cả thành một symlink vào
# dotfiles và DB/worktree/run log của tool rơi luôn vào repo (install.sh không
# gập các thư mục này). Chỉ gỡ symlink trỏ vào CHÍNH
# repo này (symlink tự đặt sang chỗ khác thì giữ), tạo thư mục thật rồi link lại
# từng file theo đúng dạng stow tạo: "../<đích của symlink gập>/<tên>".
REPO_DIR=$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")

unfold_dir() {
	local dir=$1 target src entry name
	if [[ ! -L "$dir" ]]; then
		mkdir -p "$dir"
		return
	fi
	if [[ "$(readlink -f "$dir")" != "$REPO_DIR/${dir#"$HOME"/}" ]]; then
		warn "$dir là symlink không trỏ vào $REPO_DIR, giữ nguyên"
		return
	fi
	target=$(readlink "$dir")
	[[ "$target" == /* ]] || target="../$target"
	src=$(readlink -f "$dir")
	log "tách $dir khỏi symlink stow"
	rm "$dir"
	mkdir -p "$dir"
	for entry in "$src"/* "$src"/.[!.]*; do
		[[ -e "$entry" || -L "$entry" ]] || continue
		name=${entry##*/}
		ln -s "$target/$name" "$dir/$name"
	done
}

main() {
	check_deps
	mkdir -p "$BIN_DIR"
	unfold_dir "$HOME/.no-mistakes"
	unfold_dir "$HOME/.gnhf"
	unfold_dir "$HOME/.config/treehouse"
	install_go_release treehouse "$TREEHOUSE_VER"
	install_go_release no-mistakes "$NO_MISTAKES_VER"
	install_gnhf
	install_axi_skills
	install_firstmate

	cat <<EOF

Xong. Bước tiếp:
  1. link lại dotfiles để có config: ~/dotfiles/install.sh
  2. Trong mỗi repo muốn chặn push: no-mistakes init
  3. Kiểm tra: no-mistakes doctor
  4. tmux: prefix F (menu workflow), prefix N (no-mistakes TUI)
EOF
}

# Cho phép test `source` file này mà không chạy cả bộ cài.
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
