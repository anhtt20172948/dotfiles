#!/usr/bin/env python3
"""Merge agent status lines, context limits and the dotfiles Claude Code mods
without replacing other CLI settings."""

import argparse
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

# tomllib ships with Python 3.11+; tomli is its backport for older interpreters
# (Ubuntu 22.04 and L4T ship 3.10). Without either the Codex merge cannot be
# verified, so it is skipped rather than written blind.
try:
    import tomllib
except ImportError:
    try:
        import tomli as tomllib
    except ImportError:
        tomllib = None

CODEX_ITEMS = ["model-with-reasoning", "context-used", "context-remaining", "context-window-size",
               "five-hour-limit", "weekly-limit", "total-input-tokens", "total-output-tokens"]
CLAUDE_STATUS = {"type": "command", "command": '"$HOME/.local/bin/agent-statusline-claude"'}
CLAUDE_ENV = {"CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
              "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"}
CODEX_CONTEXT = {"model_context_window": 872000, "model_auto_compact_token_limit": 523200}
TOML_VALUE = "status_line = " + json.dumps(CODEX_ITEMS)
TABLE_RE = re.compile(r"(?m)^\s*\[([^\]\n]+)\]\s*(?:#.*)?$")
STATUS_RE = re.compile(r"(?ms)^[ \t]*status_line[ \t]*=[ \t]*(?:\[[^\]]*\]|[^\n]*)")


def json_object(data, path, key):
    value = data.get(key, {})
    if not isinstance(value, dict):
        raise TypeError(f"{path}: expected {key} to be a JSON object")
    return value


def claude_mods(data, path, mods):
    """Declare the mods folder as a directory marketplace and enable its mods.

    Claude Code reads a folder marketplace's mods from the folder itself, so every
    session loads them however it was started, and an edit needs only
    /reload-plugins. A mod already listed in enabledPlugins keeps its value, so one
    turned off in /plugin stays off, and one the marketplace no longer lists is
    dropped.
    """
    manifest = mods / ".claude-plugin/marketplace.json"
    if not manifest.is_file():
        return {}
    catalog = json.loads(manifest.read_text())
    try:
        name = catalog["name"]
        plugins = [plugin["name"] for plugin in catalog["plugins"]]
    except (KeyError, TypeError) as error:
        raise ValueError(f"{manifest}: expected a name and a plugins list of named entries") from error
    source = {"source": {"source": "directory", "path": str(mods)}}
    enabled = {f"{plugin}@{name}": True for plugin in plugins}
    kept = {plugin_id: value for plugin_id, value in json_object(data, path, "enabledPlugins").items()
            if plugin_id in enabled or not plugin_id.endswith(f"@{name}")}
    return {
        "extraKnownMarketplaces": {**json_object(data, path, "extraKnownMarketplaces"), name: source},
        "enabledPlugins": {**enabled, **kept},
    }


def claude_result(path, home):
    data = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(data, dict):
        raise TypeError(f"{path}: expected a JSON object")
    env = json_object(data, path, "env")
    desired = {**data, "statusLine": CLAUDE_STATUS, "env": {**env, **CLAUDE_ENV},
               **claude_mods(data, path, home / ".config/claude-mods")}
    if data == desired:
        return None
    return json.dumps(desired, indent=2, ensure_ascii=False) + "\n"


def merge_codex_context(original):
    # Root settings must precede every table, including arrays of tables.
    first_table = re.search(r"(?m)^[ \t]*\[", original)
    end = first_table.start() if first_table else len(original)
    root, tables = original[:end], original[end:]
    for key, value in CODEX_CONTEXT.items():
        assignment = re.compile(r"(?m)^[ \t]*(?:" + key + r"|\"" + key
                                + r"\"|'" + key + r"')[ \t]*=[^\n]*")
        replacement = f"{key} = {value}"
        if assignment.search(root):
            root = assignment.sub(replacement, root)
        else:
            root = replacement + "\n" + root
    return root + tables


def codex_result(path):
    original = path.read_text() if path.exists() else ""
    parsed = tomllib.loads(original)
    desired = {**parsed, **CODEX_CONTEXT,
               "tui": {**parsed.get("tui", {}), "status_line": CODEX_ITEMS}}
    if parsed == desired:
        return None
    original = merge_codex_context(original)
    tables = list(TABLE_RE.finditer(original))
    table = next((m for m in tables if m.group(1).strip() == "tui"), None)
    if table is None:
        updated = original.rstrip("\n") + ("\n\n" if original else "") + "[tui]\n" + TOML_VALUE + "\n"
    else:
        end = next((m.start() for m in tables if m.start() > table.start()), len(original))
        body = original[table.end():end]
        existing = list(STATUS_RE.finditer(body))
        if len(existing) > 1:
            raise ValueError(f"{path}: duplicate status_line assignments")
        if existing:
            match = existing[0]
            body = body[:match.start()] + TOML_VALUE + body[match.end():]
        else:
            body = "\n" + TOML_VALUE + body
        updated = original[:table.end()] + body + original[end:]
    after = tomllib.loads(updated)
    if after != desired:
        raise ValueError(f"{path}: agent settings merge would alter other settings")
    return updated


def write_atomic(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    if not args.home.is_absolute():
        parser.error("--home must be an absolute path")
    targets = [("claude", args.home / ".claude/settings.json", lambda path: claude_result(path, args.home)),
               ("codex", args.home / ".codex/config.toml", codex_result)]
    skipped = []
    if tomllib is None:
        print(f"install-agent-statusline: skipped {targets[1][1]}: merging Codex settings "
              "needs Python 3.11+ or the tomli package", file=sys.stderr)
        skipped.append(targets.pop()[0])
    for _, path, _ in targets:
        if path.is_symlink():
            raise ValueError(f"{path}: settings symlink requires a manual merge")
    changes = [(name, path, result) for name, path, render in targets
               if (result := render(path)) is not None]
    if not args.check:
        for _, path, content in changes:
            write_atomic(path, content)
    print(json.dumps({"changed": bool(changes), "changes": [name for name, _, _ in changes],
                      "skipped": skipped}))


if __name__ == "__main__":
    errors = (OSError, TypeError, ValueError) + ((tomllib.TOMLDecodeError,) if tomllib else ())
    try:
        main()
    except errors as error:
        print(f"install-agent-statusline: {error}", file=sys.stderr)
        sys.exit(1)
