#!/usr/bin/env bash
set -Eeuo pipefail

###############################################################################
# Configuration & Helper Functions
###############################################################################

REPO_URL="https://github.com/neovim/neovim.git"
PREFIX="${HOME}/.local"
SRC_DIR="${HOME}/src"
BUILD_DIR="${SRC_DIR}/neovim"
NVIM_BIN="${PREFIX}/bin/nvim"
JOBS=$(nproc)

# Print the Neovim version installed on this machine
get_installed_version() {
    local timeline_bin=""
    
    if command -v "$NVIM_BIN" >/dev/null 2>&1; then
        timeline_bin="$NVIM_BIN"
    elif command -v nvim >/dev/null 2>&1; then
        timeline_bin="$(command -v nvim)"
    else
        echo "Not installed"
        return
    fi
    
    # First line holds the version
    "$timeline_bin" --version | head -n 1
}

# Official tags from the git remote
get_remote_tags() {
    local limit="${1:-10}"
    git ls-remote --tags --refs "${REPO_URL}" \
        | awk -F'/' '{print $3}' \
        | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
        | sort -V -r \
        | head -n "${limit}"
}

# Help
usage() {
    echo "Usage:"
    echo "  $0                  : Show the current version and a menu to pick one to install"
    echo "  $0 [NVIM_VERSION]   : Install the given version directly (e.g. v0.10.0, stable, master)"
    echo "  $0 -h | --help      : Show this help"
    exit 0
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
fi

###############################################################################
# Interactive Version Selection (version first)
###############################################################################

# Current version
CURRENT_NVIM=$(get_installed_version)

NVIM_VERSION="${1:-}"

# No argument -> interactive menu
if [ -z "${NVIM_VERSION}" ]; then
    echo "=========================================="
    echo "📌 Installed version: ${CURRENT_NVIM}"
    echo "=========================================="
    echo "==> Fetching the latest versions from GitHub..."
    echo
    
    # The 10 newest tags
    mapfile -t TAGS < <(get_remote_tags 10)
    
    # Common branches
    OPTIONS=("${TAGS[@]}" "stable" "master" "Other version...")

    echo "=========================================="
    echo "    SELECT THE NEOVIM VERSION TO INSTALL    "
    echo "=========================================="
    
    for i in "${!OPTIONS[@]}"; do
        printf "  [%2d] %s\n" "$((i+1))" "${OPTIONS[$i]}"
    done
    echo "=========================================="

    # Ask until the choice is valid
    while true; do
        read -rp "Your choice [1-${#OPTIONS[@]}]: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#OPTIONS[@]}" ]; then
            SELECTED_OPTION="${OPTIONS[$((choice-1))]}"
            break
        else
            echo "❌ Invalid choice. Please try again!"
        fi
    done

    # Manual entry
    if [ "${SELECTED_OPTION}" == "Other version..." ]; then
        read -rp "Git version/tag/branch to install (e.g. v0.9.5): " NVIM_VERSION
    else
        NVIM_VERSION="${SELECTED_OPTION}"
    fi
fi

echo
echo "📌 Current version : ${CURRENT_NVIM}"
echo "🎯 Version to install: ${NVIM_VERSION}"
read -rp "Clone and install now? (y/N): " confirm
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "❌ Installation cancelled."
    exit 0
fi

###############################################################################
# Clone & Checkout
###############################################################################

mkdir -p "${SRC_DIR}"

if [ ! -d "${BUILD_DIR}" ]; then
    echo "==> Cloning the Neovim repository..."
    git clone "${REPO_URL}" "${BUILD_DIR}"
fi

cd "${BUILD_DIR}"

echo "==> Fetching tags from git..."
git fetch --tags --quiet

# Check the version exists in git
if ! git rev-parse --verify --quiet "${NVIM_VERSION}^{commit}" >/dev/null; then
    echo "❌ ERROR: version/tag/branch '${NVIM_VERSION}' does NOT exist in git!"
    exit 1
fi

echo "==> Switching to version: ${NVIM_VERSION}"
git checkout "${NVIM_VERSION}"

###############################################################################
# Environment
###############################################################################

mkdir -p "${PREFIX}"

export PATH="${PREFIX}/bin:${PATH}"
export PKG_CONFIG_PATH="${PREFIX}/lib/pkgconfig:${PREFIX}/share/pkgconfig:${PKG_CONFIG_PATH:-}"
export LD_LIBRARY_PATH="${PREFIX}/lib:${LD_LIBRARY_PATH:-}"
export CMAKE_PREFIX_PATH="${PREFIX}:${CMAKE_PREFIX_PATH:-}"

###############################################################################
# Clean & Build Dependencies
###############################################################################

echo "==> Cleaning old builds..."
make distclean || true
rm -rf .deps build

echo "==> Building dependencies..."
make deps \
    CMAKE_BUILD_TYPE=Release \
    CMAKE_INSTALL_PREFIX="${PREFIX}" \
    DEPS_CMAKE_FLAGS="-DCMAKE_INSTALL_PREFIX=${PREFIX}" \
    -j${JOBS}

###############################################################################
# Build & Install Neovim
###############################################################################

echo "==> Building Neovim..."
make \
    CMAKE_BUILD_TYPE=Release \
    CMAKE_INSTALL_PREFIX="${PREFIX}" \
    DEPS_CMAKE_FLAGS="-DCMAKE_INSTALL_PREFIX=${PREFIX}" \
    -j${JOBS}

echo "==> Installing into ${PREFIX}..."
make install

###############################################################################
# Update PATH in Shell RC
###############################################################################

mkdir -p "${HOME}/.local/bin"

if ! grep -q '.local/bin' "${HOME}/.zshrc" 2>/dev/null; then
cat <<EOF >> "${HOME}/.zshrc"

export PATH="\$HOME/.local/bin:\$PATH"
export LD_LIBRARY_PATH="\$HOME/.local/lib:\$LD_LIBRARY_PATH"
export PKG_CONFIG_PATH="\$HOME/.local/lib/pkgconfig:\$PKG_CONFIG_PATH"

EOF
fi

###############################################################################
# Done
###############################################################################

echo
echo "✅ Neovim [${NVIM_VERSION}] installed:"
echo "--------------------------------------"
"${HOME}/.local/bin/nvim" --version | head -5
echo "--------------------------------------"
