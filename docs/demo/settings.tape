# Shared by every tape; render.sh puts Output and Set Theme in front of it.
# kitty-like: no window chrome, 10px padding, a FOSS Nerd Font (CI installs it;
# the workstation font, SFMono Nerd Font Complete, is not redistributable).
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 14
Set LineHeight 1.15
Set Width 1280
Set Height 720
Set Padding 10
Set TypingSpeed 40ms
Set CursorBlink false
