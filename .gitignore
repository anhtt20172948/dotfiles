# Ignore OS-specific files
.DS_Store
Thumbs.db

# Editor and IDE files
*.swp
*~
.vscode/
.idea/

# Log files and temporary files
*.log
tmp/
.cache/
__pycache__/

# Shell history and session files
.history
.session

# ...existing custom ignore rules...
.zshrc
.bashrc
# Agent workflow (install_agent_workflow): track config only, never state.
# The tools write state next to their config: ignore it so DBs/run logs are never committed.
.no-mistakes/*
!.no-mistakes/config.yaml
.gnhf/*
!.gnhf/config.yml
# Claude Code: track only hand-written skills; ignore the state Claude writes to .claude/ (projects, sessions, jobs, cache...).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/dotfiles-patterns/
# Type declarations Claude Code writes beside a mod each time it loads one.
.config/claude-mods/*/.claude-plugin/types/
.treehouse/
# Local account credentials must never be versioned.
.claude-b/
.credentials.json
.claude.json
*.token
*.tokens
*.token.json
*.tokens.json
.env
.env.*

# DMS writes kitty theme files from the wallpaper at runtime (per host).
.config/kitty/dank-*.conf
.config/kitty/remote-palette-*.conf
.config/kitty/remote-palette.conf

# Firstmate captain preferences are per host: never track them.
.local/share/firstmate/data/captain.md

# docs/demo/render.sh output (CI uploads it as an artifact instead).
docs/demo/out/
