# Ignore OS-specific files
.DS_Store
Thumbs.db

# Editor and IDE files
*.swp
*~
.vscode/
.idea/

# Log files and temporary files
*.log
tmp/
.cache/
__pycache__/

# Shell history and session files
.history
.session

# ...existing custom ignore rules...
.zshrc
.bashrc
# Agent workflow (install_agent_workflow): chỉ track config, không track state.
# Tool ghi state ngay cạnh config: chặn để không lỡ commit DB/run log.
.no-mistakes/*
!.no-mistakes/config.yaml
.gnhf/*
!.gnhf/config.yml
# Claude Code: chỉ track skill tự viết, chặn state Claude ghi vào .claude/ (projects, sessions, jobs, cache...).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/dotfiles-patterns/
.treehouse/
# Local account credentials must never be versioned.
.claude-b/
.credentials.json
.claude.json
*.token
*.tokens
*.token.json
*.tokens.json
.env
.env.*

# Firstmate captain preferences are per host: never track them.
.local/share/firstmate/data/captain.md
