# Ignore OS-specific files
.DS_Store
Thumbs.db

# Editor and IDE files
*.swp
*~
.vscode/
.idea/

# Log files and temporary files
*.log
tmp/
.cache/

# Shell history and session files
.history
.session

# ...existing custom ignore rules...
.zshrc
.bashrc
# Agent workflow (install_agent_workflow): chỉ track config, không track state.
# Tool ghi state ngay cạnh config: chặn để không lỡ commit DB/run log.
.no-mistakes/*
!.no-mistakes/config.yaml
.gnhf/*
!.gnhf/config.yml
.treehouse/
